# kppackaging.com on Hostinger (LiteSpeed). Copied into dist/ by build.js.
ErrorDocument 404 /404.html
Options -Indexes

RewriteEngine On

# https + apex only
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://kppackaging.com/$1 [R=301,L]

# Old Webflow URLs -> new pages (keeps their search ranking)
RewriteRule ^about-us(\.html|/.*)?$ /about/ [R=301,L,NC]
RewriteRule ^contact-us(\.html|/.*)?$ /contact/ [R=301,L,NC]
RewriteRule ^collection(\.html|/.*)?$ /products/ [R=301,L,NC]
RewriteRule ^polyethylene-coated-stiffener-paper(\.html|/.*)?$ /products/pe-coated-stiffener-paper/ [R=301,L,NC]
RewriteRule ^other-specialised-paper(\.html|/.*)?$ /products/bactite/ [R=301,L,NC]
RewriteRule ^(glassine-paper|mg-poster-paper|4-ply-paper|3-ply-paper|cupstock-paper|mg-kraft|chromo-paper|folding-box-board|non-tearable-paper|greaseproof-paper|duplex-board|maplitho-paper|tissue-paper)(\.html|/.*)?$ /products/$1/ [R=301,L,NC]

# Leftover Webflow export folders and backups: gone
RewriteRule (^|/)[^/]*_files(/|$) - [G,L]
RewriteRule ^backup1(/|$) - [G,L]

# Inquiry log written by send-inquiry.php: never public
RewriteRule ^inquiries(/|$) - [F,L]

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # /assets, /css and /js URLs carry ?v=<hash>, so they can be cached for a year
  <FilesMatch "\.(webp|png|jpe?g|svg|ico|css|js|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
